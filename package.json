{
  "name": "valorant-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @valorant-manager/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
